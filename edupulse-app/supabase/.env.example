# ─────────────────────────────────────────────────────────────────────────────
# EduPulse — environment variables
# Copy to `.env.local` and fill in the values from your Supabase project.
# `.env.local` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Public Supabase project URL (safe to expose to the browser; RLS applies).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser; RLS applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute site URL used to build email confirmation / reset redirect links.
# Optional in development (falls back to the request origin). Set it in staging
# and production, e.g. https://app.edupulse.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Server-only secrets — never expose these to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Service role key. Bypasses RLS. Used only for privileged server operations
# (mentor verification, payment verification, report moderation). Not wired up
# in Milestone 1 but reserved for later milestones.
SUPABASE_SERVICE_ROLE_KEY=
