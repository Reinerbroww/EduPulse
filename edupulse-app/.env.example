# EduPulse â€” environment variables
# Copy to `.env.local` and fill in the values from your Supabase project.
# `.env.local` is git-ignored and must never be committed.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Public Supabase project URL (safe to expose to the browser; RLS applies).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser; RLS applies).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site URL used to build email confirmation / reset redirect links.
# Optional in development (falls back to the request origin). Set it in staging
# and production, e.g. https://app.edupulse.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo mode (development / staging / demos only). When set to "true" the UI also
# renders clearly labelled "Contoh Demo" cards for partners, groups, mentors,
# goals, sessions, and an empty-account dashboard preview. The fixtures are
# static content: they are never written to the database, never overwrite real
# data, and can never accept real bookings. Demo content only appears when the
# account has no real data for that area. Leave empty (or "false") in production.
NEXT_PUBLIC_DEMO_MODE=

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Server-only secrets â€” never expose these to the browser.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Service role key. Bypasses RLS. Used only for privileged server operations
# (mentor verification, payment verification, report moderation). Not wired up
# in Milestone 1 but reserved for later milestones.
SUPABASE_SERVICE_ROLE_KEY=
